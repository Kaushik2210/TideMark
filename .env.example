# Copy to .env and fill in. Never commit .env.

# Pipeline -------------------------------------------------------------
# Planetary Computer works anonymously (signed URLs, lower rate limits).
# An optional subscription key raises limits: https://planetarycomputer.microsoft.com/account/request
PC_SDK_SUBSCRIPTION_KEY=

# Overpass endpoint (primary). Mirrors are tried in order if this fails.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Be polite to free APIs: minimum seconds between requests.
TIDEMARK_MIN_REQUEST_INTERVAL=1.0

# Web (Next.js) --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; used by the moderation/matching route. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
